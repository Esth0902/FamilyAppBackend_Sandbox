### Calendar - Lire le board calendrier
GET {{baseUrl}}/api/calendar/board?from=2026-02-16&to=2026-03-01
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}

> {%
  const events = Array.isArray(response.body?.events) ? response.body.events : [];
  const mealPlan = Array.isArray(response.body?.meal_plan) ? response.body.meal_plan : [];
  const firstEvent = events[0];
  const firstMealPlan = mealPlan[0];
  if (firstEvent?.id) {
    client.global.set('calendar_event_id', firstEvent.id);
    client.log('calendar_event_id capture: ' + firstEvent.id);
  }
  if (firstMealPlan?.id) {
    client.global.set('calendar_meal_plan_id', firstMealPlan.id);
    client.log('calendar_meal_plan_id capture: ' + firstMealPlan.id);
  }
%}

### Calendar - Creer un evenement prive au foyer
POST {{baseUrl}}/api/calendar/events
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}

{
  "title": "Dentiste Mila",
  "description": "Controle annuel a 15h20",
  "start_at": "2026-02-24T15:20:00",
  "end_at": "2026-02-24T16:00:00",
  "is_shared_with_other_household": false
}

> {%
  const event = response.body?.event;
  if (event?.id) {
    client.global.set('calendar_event_id', event.id);
    client.log('calendar_event_id cree: ' + event.id);
  }
%}

### Calendar - Creer un evenement partage avec l autre foyer (parent uniquement)
POST {{baseUrl}}/api/calendar/events
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}

