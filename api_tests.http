### Mettre a jour la configuration du foyer courant
# Endpoint réservé au rôle parent (403 pour un enfant)
# Realtime:
# - Diffuse sur private-household.{household_id}
# - Event: household.realtime
# - Payload: { module: "household", type: "config_updated", payload.modules.<module>.enabled }
PATCH {{baseUrl}}/api/households/config
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}

{
  "household_name": "Ma Famille Test V2 - Modifiee",
  "modules": {
    "meals": {
      "enabled": true,
      "options": {
        "recipes": true,
        "polls": true,
        "shopping_list": false
      },
      "settings": {
        "poll_day": 6,
        "poll_time": "11:00",
        "poll_duration": 24,
        "default_servings": 5,
        "dietary_tags": ["lactose-free", "no-shellfish"]
      }
    },
    "tasks": {
      "enabled": true,
      "settings": {
        "reminders_enabled": true,
        "alternating_custody_enabled": true,
        "custody_change_day": 5,
        "custody_home_week_start": "2026-03-13"
      }
    },
    "calendar": {
      "enabled": true,
      "settings": {
        "shared_view_enabled": true,
        "absence_tracking_enabled": true
      }
    },
    "budget": {
      "enabled": true,
      "settings": {
        "currency": "EUR"
      }
    }
  }
}


### Meal Polls V2 - Lire le sondage actif
GET {{baseUrl}}/api/meal-polls/active
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}

> {%
  const poll = response.body.poll;
  if (poll && poll.id) {
    client.global.set('meal_poll_id', poll.id);
    const firstOption = Array.isArray(poll.options) && poll.options.length > 0 ? poll.options[0] : null;
    if (firstOption) {
      client.global.set('meal_poll_option_id', firstOption.id);
      client.global.set('meal_poll_recipe_id', firstOption.recipe_id);
    }
    client.log('meal_poll_id capture: ' + poll.id);
  }
%}

### Meal Polls V2 - Ouvrir un sondage (Parent)
# NOTE: max_votes_per_user ne peut pas depasser le nombre de recettes dans recipe_ids.
# NOTE: planning_start_date et planning_end_date definissent la plage de dates autorisee pour la planification.
POST {{baseUrl}}/api/meal-polls
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}

{
  "title": "Sondage semaine test",
  "recipe_ids": [1, 2],
  "planning_start_date": "2026-02-23",
  "planning_end_date": "2026-03-01",
  "duration_hours": 24,
  "max_votes_per_user": 2
}

> {%
  const poll = response.body.poll;
  if (poll && poll.id) {
    client.global.set('meal_poll_id', poll.id);
    const firstOption = Array.isArray(poll.options) && poll.options.length > 0 ? poll.options[0] : null;
    if (firstOption) {
      client.global.set('meal_poll_option_id', firstOption.id);
      client.global.set('meal_poll_recipe_id', firstOption.recipe_id);
    }
  }
%}

