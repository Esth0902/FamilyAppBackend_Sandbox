### Notifications - Recuperer celles en attente d'envoi local
GET {{baseUrl}}/api/notifications/pending
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}
X-Household-Id: {{active_household_id}}

> {%
  const notifications = Array.isArray(response.body.notifications) ? response.body.notifications : [];
  if (notifications.length > 0) {
    client.global.set('notification_id', notifications[0].id);
    client.log('notification_id capture: ' + notifications[0].id);
  }
%}

# Réponse attendue (champs utiles pour le frontend temps réel):
# - notifications[].household_id (null|number)
# - notifications[].sent_at (ISO 8601|null)
# - notifications[].read_at (ISO 8601|null)
# - notifications[].data.status (pending|accepted|refused) pour les demandes actionnables
# - notifications[].data.household_name (string) pour les notifications de tâches multi-foyers

### Notifications - Recuperer celles en attente sur tous les foyers du user
GET {{baseUrl}}/api/notifications/pending?all_households=1
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}

# Réponse attendue:
# - même format que /notifications/pending
# - inclut les notifications des autres foyers où l'utilisateur est membre

