### Shopping Lists - Ajouter un ingrédient manuel
# Règle d'accès:
# - parent: peut ajouter manuel + non-manuel
# - enfant: peut ajouter uniquement un élément manuel (is_manual_addition=true implicite)
# - end_date est optionnelle pour les taches ponctuelles et genere une instance par jour
POST {{baseUrl}}/api/shopping-lists/{{shopping_list_id}}/items
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}

{
  "name": "banane",
  "quantity": 6,
  "unit": "piece"
}

