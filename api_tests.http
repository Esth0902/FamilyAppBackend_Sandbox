### Tasks - Créer une instance (parent ou enfant)
# Règle:
# - parent: peut attribuer à n'importe quel membre du foyer via user_id
# - enfant: ne peut s'attribuer qu'à lui-même (même si user_id est envoyé)
# - end_date est optionnelle pour les taches ponctuelles et genere une instance par jour
POST {{baseUrl}}/api/tasks/instances
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}

{
  "task_template_id": {{task_template_id}},
  "due_date": "2026-02-20",
  "end_date": "2026-02-22"
}

> {%
  const instance = response.body?.instance;
  if (instance?.id) {
    client.global.set('task_instance_id', instance.id);
    client.log('task_instance_id cree: ' + instance.id);
  }
%}

