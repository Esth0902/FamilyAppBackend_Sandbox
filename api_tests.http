    { "name": "oignon", "quantity": 1, "unit": "unitÃ©", "category": "fruits et lÃ©gumes" },
    { "name": "poivron", "quantity": 1, "unit": "unitÃ©", "category": "fruits et lÃ©gumes" },
    { "name": "courgette", "quantity": 1, "unit": "unitÃ©", "category": "fruits et lÃ©gumes" },
    { "name": "tomates concassÃ©es", "quantity": 400, "unit": "g", "category": "Ã©picerie salÃ©e" },
    { "name": "ricotta", "quantity": 200, "unit": "g", "category": "crÃ¨merie" },
    { "name": "parmesan rÃ¢pÃ©", "quantity": 40, "unit": "g", "category": "crÃ¨merie" },
