### Broadcast - Auth private household channel (WebSocket Reverb)
# Endpoint utilise par le client mobile pour s'abonner a:
# - private-household.{household_id}
# Event diffuse:
# - household.realtime avec payload { module, type, payload, emitted_at }
POST {{baseUrl}}/api/broadcasting/auth
Content-Type: application/x-www-form-urlencoded
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}

socket_id=1234.5678&channel_name=private-household.{{household_id}}

### Tasks - Lire le tableau des taches
GET {{baseUrl}}/api/tasks/board?from=2026-02-16&to=2026-02-28
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}

> {%
  const templates = Array.isArray(response.body?.templates) ? response.body.templates : [];
  const instances = Array.isArray(response.body?.instances) ? response.body.instances : [];
  const firstTemplate = templates[0];
  const firstInstance = instances[0];
  if (firstTemplate?.id) {
    client.global.set('task_template_id', firstTemplate.id);
    client.log('task_template_id capture: ' + firstTemplate.id);
  }
  if (firstInstance?.id) {
    client.global.set('task_instance_id', firstInstance.id);
    client.log('task_instance_id capture: ' + firstInstance.id);
  }
%}

