### Mettre a jour la configuration du foyer courant
PATCH {{baseUrl}}/api/households/config
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}

{
  "household_name": "Ma Famille Test V2 - Modifiee",
  "modules": {
    "meals": {
      "enabled": true,
      "options": {
        "recipes": true,
        "polls": true,
        "shopping_list": false
      },
      "settings": {
        "poll_day": 6,
        "poll_time": "11:00",
        "poll_duration": 24,
        "default_servings": 5,
        "dietary_tags": ["lactose-free", "no-shellfish"]
      }
    },
    "tasks": {
      "enabled": true,
      "settings": {
        "reminders_enabled": true,
        "templates": [
          {
            "name": "Passer l'aspirateur",
            "recurrence": "weekly",
            "recurrence_days": [6],
            "is_rotation": true,
            "rotation_cycle_weeks": 1
          }
        ]
      }
    },
    "calendar": {
      "enabled": true,
      "settings": {
        "shared_view_enabled": true,
        "absence_tracking_enabled": true
      }
    },
    "budget": {
      "enabled": true,
      "settings": {
        "currency": "EUR"
      }
    }
  }
}


### Meal Polls V2 - Lire le sondage actif
GET {{baseUrl}}/api/meal-polls/active
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}

> {%
  const poll = response.body.poll;
  if (poll && poll.id) {
    client.global.set('meal_poll_id', poll.id);
    const firstOption = Array.isArray(poll.options) && poll.options.length > 0 ? poll.options[0] : null;
    if (firstOption) {
      client.global.set('meal_poll_option_id', firstOption.id);
      client.global.set('meal_poll_recipe_id', firstOption.recipe_id);
    }
    client.log('meal_poll_id capture: ' + poll.id);
  }
%}

### Meal Polls V2 - Ouvrir un sondage (Parent)
# NOTE: max_votes_per_user ne peut pas depasser le nombre de recettes dans recipe_ids.
# NOTE: planning_start_date et planning_end_date definissent la plage de dates autorisee pour la planification.
POST {{baseUrl}}/api/meal-polls
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}

{
  "title": "Sondage semaine test",
  "recipe_ids": [1, 2],
  "planning_start_date": "2026-02-23",
  "planning_end_date": "2026-03-01",
  "duration_hours": 24,
  "max_votes_per_user": 2
}

> {%
  const poll = response.body.poll;
  if (poll && poll.id) {
    client.global.set('meal_poll_id', poll.id);
    const firstOption = Array.isArray(poll.options) && poll.options.length > 0 ? poll.options[0] : null;
    if (firstOption) {
      client.global.set('meal_poll_option_id', firstOption.id);
      client.global.set('meal_poll_recipe_id', firstOption.recipe_id);
    }
  }
%}

### Meal Polls V2 - Voter (toggle) sur une option
POST {{baseUrl}}/api/meal-polls/{{meal_poll_id}}/vote
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}

{
  "option_id": {{meal_poll_option_id}}
}

### Meal Polls V2 - Voter (synchronisation des choix)
# NOTE: option_ids doit contenir exactement `max_votes_per_user` options.
POST {{baseUrl}}/api/meal-polls/{{meal_poll_id}}/votes/sync
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}

{
  "option_ids": [{{meal_poll_option_id}}]
}

### Meal Polls V2 - Cloturer le sondage (Parent)
POST {{baseUrl}}/api/meal-polls/{{meal_poll_id}}/close
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}

### Meal Polls V2 - Valider les resultats + meal plan
POST {{baseUrl}}/api/meal-polls/{{meal_poll_id}}/validate
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}

{
  "selected_recipe_ids": [{{meal_poll_recipe_id}}],
  "meal_plan": [
    {
      "date": "2026-02-20",
      "meal_type": "soir",
      "recipe_id": {{meal_poll_recipe_id}},
      "servings": 4
    }
  ]
}

