### Setup initial V2 (foyer + membres + modules)
POST {{baseUrl}}/api/households
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}

{
  "household_name": "Ma Famille Test V2",
  "members": [
    {
      "name": "Deuxieme Parent",
      "role": "parent"
    },
    {
      "name": "Enfant Test",
      "role": "enfant",
      "budget": {
        "base_amount": 20,
        "recurrence": "weekly",
        "reset_day": 1,
        "allow_advances": true,
        "max_advance_amount": 10
      }
    }
  ],
  "modules": {
    "meals": {
      "enabled": true,
      "options": {
        "recipes": true,
        "polls": true,
        "shopping_list": true
      },
      "settings": {
        "poll_day": 5,
        "poll_time": "10:00",
        "poll_duration": 24,
        "default_servings": 4,
        "dietary_tags": ["vegetarian", "no-pork"]
      }
    },
    "tasks": {
      "enabled": true,
      "settings": {
        "reminders_enabled": true,
        "templates": [
          {
            "name": "Sortir les poubelles",
            "description": "Bac noir et PMC",
            "recurrence": "weekly",
            "recurrence_days": [3, 4],
            "is_rotation": true,
            "rotation_cycle_weeks": 2
          },
          {
            "name": "Ranger la chambre",
            "recurrence": "daily",
            "recurrence_days": [1, 2, 3, 4, 5, 6, 7],
            "is_rotation": false
          }
        ]
      }
    },
    "calendar": {
      "enabled": true,
      "settings": {
        "shared_view_enabled": true
      }
    },
    "budget": {
      "enabled": true,
      "settings": {
        "currency": "EUR"
      }
    }
  }
}

> {%
    const hid = response.body.household?.id ?? response.body.id ?? response.body.data?.id;
    client.global.set("household_id", hid);
    client.log("household_id V2 capture : " + hid);
%}

