### Budget - Charger le board
GET {{baseUrl}}/api/budget/board
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}

> {%
  const children = Array.isArray(response.body?.children) ? response.body.children : [];
  const firstChild = children[0]?.child;
  const pending = Array.isArray(response.body?.pending_advance_requests) ? response.body.pending_advance_requests : [];
  if (firstChild?.id) {
    client.global.set('budget_child_id', firstChild.id);
    client.log('budget_child_id capture: ' + firstChild.id);
  }
  if (pending[0]?.id) {
    client.global.set('budget_advance_request_id', pending[0].id);
    client.log('budget_advance_request_id capture: ' + pending[0].id);
  }
%}

