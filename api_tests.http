### Variables

@baseUrl = http://localhost:8000
@contentType = application/json

### Inscription d'un nouvel utilisateur + Capture du token
POST http://localhost:8000/api/register
Content-Type: application/json
Accept: application/json

{
    "name": "userTest",
    "email": "user@test.com",
    "password": "password123",
    "password_confirmation": "password123"
}

> {%
    if (response.status === 200 || response.status === 201) {
        client.global.set("auth_token", response.body.token);
        client.log("Token d'inscription capturé : " + response.body.token);
    } else {
        client.log("Register status: " + response.status);
    }
%}

### Test de login
POST {{baseUrl}}/api/login
Content-Type: {{contentType}}
Accept: {{contentType}}

{
  "email": "user@test.com",
  "password": "password123"
}

> {%
    client.global.set("auth_token", response.body.token);
    client.log("Token capturé : " + response.body.token);
%}

### Créer un ménage (capture household_id)
POST {{baseUrl}}/api/households
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}

{
  "name": "Ma Famille Test"
}

> {%
    const hid = response.body.id ?? response.body.data?.id;
    client.global.set("household_id", hid);
    client.log("household_id capturé : " + hid);
%}
### 4) Demander des idées à l'IA (intent=ideas)
POST {{baseUrl}}/api/recipes/suggest
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}

{
  "preferences": "Végétarien, cuisine italienne",
  "count": 3,
  "intent": "ideas"
}

### 5) Demander une recette spécifique à l'IA (intent=specific)
POST {{baseUrl}}/api/recipes/suggest
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}

{
  "preferences": "Lasagnes aux légumes",
  "intent": "specific"
}

### 6) Preview recette (endpoint dédié)
POST {{baseUrl}}/api/recipes/preview-ai
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}

{
  "title": "Lasagnes aux légumes"
}

### 7) AI Store (exemple valide AVEC type + category)
# IMPORTANT:
# - type doit être: petit-déjeuner, entrée, plat principal, dessert, collation, boisson, autre
# - category doit être: fruits et légumes, boucherie, poissonnerie, crèmerie, épicerie salée, épicerie sucrée, boissons, surgelés, entretien et hygiène, autre
POST {{baseUrl}}/api/recipes/ai-store
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}

{
  "household_id": 3,
  "title": "Lasagnes aux légumes",
  "type": "plat principal",
  "description": "Un plat italien classique revisité avec des légumes pour une version végétarienne délicieuse.",
  "instructions": "Étape 1 : Préchauffez le four à 180°C. Étape 2 : ...",
  "ingredients": [
    { "name": "pâtes à lasagnes", "quantity": 250, "unit": "g", "category": "épicerie salée" },
    { "name": "oignon", "quantity": 1, "unit": "unité", "category": "fruits et légumes" },
    { "name": "poivron", "quantity": 1, "unit": "unité", "category": "fruits et légumes" },
    { "name": "courgette", "quantity": 1, "unit": "unité", "category": "fruits et légumes" },
    { "name": "tomates concassées", "quantity": 400, "unit": "g", "category": "épicerie salée" },
    { "name": "ricotta", "quantity": 200, "unit": "g", "category": "crèmerie" },
    { "name": "parmesan râpé", "quantity": 40, "unit": "g", "category": "crèmerie" },
    { "name": "sel", "quantity": 0, "unit": "au goût", "category": "autre" }
  ]
}

> {%
    const rid = response.body.id ?? response.body.data?.id;
    client.global.set("recipe_id", rid);
    client.log("recipe_id capturé : " + rid);
%}

### 8) Vérifier la liste des recettes (doit contenir la recette AI)
GET {{baseUrl}}/api/recipes
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}

### 9) Récupérer la recette créée
GET {{baseUrl}}/api/recipes/{{recipe_id}}
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}

### 10) Test NEGATIF: type invalide -> doit renvoyer 422
POST {{baseUrl}}/api/recipes/ai-store
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}

{
  "household_id": 3,
  "title": "Test mauvais type",
  "type": "plat",
  "description": "test",
  "instructions": "test",
  "ingredients": [
    { "name": "oignon", "quantity": 1, "unit": "unité", "category": "fruits et légumes" }
  ]
}

### 11) Test NEGATIF: category invalide -> doit renvoyer 422
POST {{baseUrl}}/api/recipes/ai-store
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}

{
  "household_id": 3,
  "title": "Test mauvaise catégorie",
  "type": "plat principal",
  "description": "test",
  "instructions": "test",
  "ingredients": [
    { "name": "oignon", "quantity": 1, "unit": "unité", "category": "frais" }
  ]
}

### 12) Test pivot unique: doublon ingrédient (ne doit PAS casser si tu utilises sync)
# Si ton controller est encore en attach(), ça risque 500.
POST {{baseUrl}}/api/recipes/ai-store
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}

{
  "household_id": 3,
  "title": "Test doublons",
  "type": "plat principal",
  "description": "test",
  "instructions": "test",
  "ingredients": [
    { "name": "oignon", "quantity": 1, "unit": "unité", "category": "fruits et légumes" },
    { "name": "oignon", "quantity": 2, "unit": "unité", "category": "fruits et légumes" }
  ]
}

### 13) Update recette (si tu veux tester update)
PUT {{baseUrl}}/api/recipes/1
#{{recipe_id}}
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}

{
  "title": "Lasagnes aux légumes (update)",
  "type": "plat principal",
  "description": "update",
  "instructions": "update",
  "ingredients": [
    { "name": "oignon", "quantity": 1, "unit": "unité", "category": "fruits et légumes" },
    { "name": "ricotta", "quantity": 250, "unit": "g", "category": "crèmerie" }
  ]
}

### 14) Delete recette (cleanup)
DELETE {{baseUrl}}/api/recipes/3
Accept: {{contentType}}
Authorization: Bearer {{auth_token}}
